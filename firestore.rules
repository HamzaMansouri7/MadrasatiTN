rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Users Collection & per-user subcollections (owner-only privacy)
    match /users/{userId} {
      allow read, write, delete: if isOwner(userId);

      match /notificationState/{notifId} {
        allow read, write: if isOwner(userId);
      }

      match /watchlist/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Children collection (for parents managing children)
    match /children/{childId} {
      allow read, write, delete: if isSignedIn() && (
        resource == null || resource.data.parentUid == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.parentUid == request.auth.uid
      );

      match /activity/{activityId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/children/$(childId)).data.parentUid == request.auth.uid;
      }
    }

    // Public teacher directory cards (whitelisted fields, length limits, immutable verification)
    match /teachers/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 500)
        && (!('verified' in request.resource.data) || request.resource.data.verified in ['none', 'pending'])
        && (!('coursesCount' in request.resource.data))
        && (!('rating' in request.resource.data))
        && (!('verifiedBadge' in request.resource.data));

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'name', 'title', 'school', 'delegation', 'bio', 
          'avatarUrl', 'taughtGrades', 'subjects', 'languages', 'verified', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 500)
        && (
          // verified can only stay same or transition from 'none' to 'pending'
          request.resource.data.get('verified', 'none') == resource.data.get('verified', 'none')
          || (resource.data.get('verified', 'none') == 'none' && request.resource.data.get('verified', 'none') == 'pending')
        );

      allow delete: if isOwner(userId);
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Homeworks Collection
    match /homeworks/{homeworkId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Exercise bank (teacher-published series/exams)
    match /exercises/{exerciseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Parent/teacher Q&A threads (asking is login-gated in the UI)
    match /question_threads/{threadId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Published pedagogical articles
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // System and activity notifications (immutable, author-restricted creation)
    match /notifications/{notifId} {
      // Direct notifications (recipientId set) are readable only by their recipient.
      // They must use targetRole 'direct' so the public role query (targetRole in [role,'all'])
      // never matches them; rules are not filters and a single denied doc fails the whole query.
      allow read: if resource.data.get('recipientId', null) == null
                  || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && (request.resource.data.get('recipientId', null) == null
                        || request.resource.data.targetRole == 'direct');
      allow update, delete: if false;
    }
  }
}
