rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Users Collection & per-user notification state
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);

      match /notificationState/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public teacher directory cards (mirrored from users by the app)
    match /teachers/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Homeworks Collection
    match /homeworks/{homeworkId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Exercise bank (teacher-published series/exams)
    match /exercises/{exerciseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Parent/teacher Q&A threads (asking is login-gated in the UI)
    match /question_threads/{threadId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Published pedagogical articles
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // System and activity notifications (immutable, author-restricted creation)
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
