# Names only. Real values live in .env (gitignored) and in the VPS PM2 env.
# The server does not auto-load .env: export it first (set -a; source .env; set +a) or use `node --env-file=.env`.

# Gemini: free keys from separate billing-free projects (rotated in this order).
GEMINI_API_KEY=""
GEMINI_API_KEYS=""        # comma-separated, used by the server chain
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
# GEMINI_MODELS=""        # optional, default gemini-flash-latest,...

# Free fallbacks.
OPENROUTER_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# IMAGE_CHAIN=""          # optional, default pollinations,cloudflare,svg

UPLOAD_DIR="./uploads"
PORT=4000
NVIDIA_API_KEY=""
# Prepaid paid Gemini key: images only, soft daily budget (0 disables).
GEMINI_PAID_API_KEY=""
# GEMINI_PAID_IMAGE_DAILY=40
POLLINATIONS_API_KEY=""
